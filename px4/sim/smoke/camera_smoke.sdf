<?xml version="1.0"?>
<!-- Phase 4 step 1: does a downward camera render headless under WSL2? A static camera
     5 m above a checker of boxes, 320x240 at 10 Hz. tools/camera_smoke.sh runs it. -->
<sdf version="1.9">
  <world name="camera_smoke">
    <physics type="ode"><max_step_size>0.004</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="link">
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><diffuse>0.6 0.6 0.6 1</diffuse><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
    </model>
    <model name="target">
      <static>true</static>
      <link name="link">
        <visual name="black"><pose>0.5 0.5 0.01 0 0 0</pose><geometry><box><size>1 1 0.02</size></box></geometry>
          <material><diffuse>0 0 0 1</diffuse><ambient>0 0 0 1</ambient></material></visual>
        <visual name="white"><pose>-0.5 0.5 0.01 0 0 0</pose><geometry><box><size>1 1 0.02</size></box></geometry>
          <material><diffuse>1 1 1 1</diffuse><ambient>1 1 1 1</ambient></material></visual>
      </link>
    </model>
    <model name="camera">
      <static>true</static>
      <pose>0 0 5 0 1.5708 0</pose>
      <link name="link">
        <sensor name="down_cam" type="camera">
          <topic>smoke/down_cam</topic>
          <update_rate>10</update_rate>
          <always_on>1</always_on>
          <camera>
            <horizontal_fov>1.5</horizontal_fov>
            <image><width>320</width><height>240</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>100</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
