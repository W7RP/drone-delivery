# Parts logistics in Pittsburgh: warehouse pads in the Strip District ship spare parts to the
# Mon Valley plants and the Oakland hospitals. Generated by pipeline/run.sh from
# pipeline/scenario.toml.in; edit the template, not this file. Pads, lanes and the truck matrix
# come from public data through the pipeline (derived/); every number below is a placeholder
# (assumption = true), not real data.

schema_version = "1.3.0"

# No scheduled faults; random pad-controller faults still follow pad_ops.pc_fault_rate_per_h.
faults = []

[meta]
name = "parts_logistics_pittsburgh"
preset = "PARTS_LOGISTICS"
status = "COMPLETE"
city = "Pittsburgh"
description = "Anchor preset on real Pittsburgh sites: Strip District warehouses to Mon Valley plants and Oakland hospitals, seven days."

[sim]
seed = { value = 42, unit = "1", assumption = true }
duration_s = { value = 604800.0, unit = "s", assumption = true }
warmup_s = { value = 3600.0, unit = "s", assumption = true }
start_time_of_day_s = { value = 25200.0, unit = "s", assumption = true }
replications = { value = 1, unit = "count", assumption = true }

[geo]
origin_lat_deg = { value = 40.4406, unit = "deg", assumption = true }
origin_lon_deg = { value = -79.9959, unit = "deg", assumption = true }

# Pads (derived/pads.toml), lanes (derived/lanes.csr.bin) and the truck matrix
# (derived/truck_matrix.bin), relative to this file.
[network_files]
dir = "derived"

[drone]
# @fleet_size: written by the pipeline (scenario.py).
empty_mass_kg = { value = 9.0, unit = "kg", assumption = true }
latch_mass_kg = { value = 0.6, unit = "kg", assumption = true }
mtow_kg = { value = 16.0, unit = "kg", assumption = true }
battery_capacity_j = { value = 3240000.0, unit = "J", assumption = true }
initial_soc = { value = 1.0, unit = "1", assumption = true }
reserve_soc = { value = 0.2, unit = "1", assumption = true }
charge_target_soc = { value = 0.95, unit = "1", assumption = true }
cruise_speed_mps = { value = 15.0, unit = "m/s", assumption = true }
cruise_power_ref_w = { value = 1000.0, unit = "W", assumption = true }
hover_power_ref_w = { value = 1200.0, unit = "W", assumption = true }
power_ref_mass_kg = { value = 14.6, unit = "kg", assumption = true }
takeoff_s = { value = 30.0, unit = "s", assumption = true }
approach_s = { value = 45.0, unit = "s", assumption = true }
go_around_s = { value = 40.0, unit = "s", assumption = true }
hop_s = { value = 20.0, unit = "s", assumption = true }
p_release_fault = { value = 0.01, unit = "1", assumption = true }
p_latch_fault = { value = 0.01, unit = "1", assumption = true }

[payload]
pod_gross_mass_kg = { value = 5.0, unit = "kg", assumption = true }
pod_empty_mass_kg = { value = 1.2, unit = "kg", assumption = true }

[charging]
mode = "OUT_CONTACTS"
power_w = { value = 1500.0, unit = "W", assumption = true }
efficiency = { value = 0.9, unit = "1", assumption = true }
charge_while_parked = false

[pad_ops]
pod_place_s = { value = 60.0, unit = "s", assumption = true }
pod_remove_s = { value = 120.0, unit = "s", assumption = true }
release_s = { value = 5.0, unit = "s", assumption = true }
release_verify_s = { value = 3.0, unit = "s", assumption = true }
latch_s = { value = 8.0, unit = "s", assumption = true }
latch_verify_s = { value = 3.0, unit = "s", assumption = true }
manual_release_s = { value = 45.0, unit = "s", assumption = true }
manual_latch_s = { value = 60.0, unit = "s", assumption = true }
p_marker_detect = { value = 0.97, unit = "1", assumption = true }
max_go_arounds = { value = 2, unit = "count", assumption = true }
release_max_retries = { value = 1, unit = "count", assumption = true }
latch_max_retries = { value = 1, unit = "count", assumption = true }
out_empty_policy = "DEPART_EMPTY"
out_empty_wait_timeout_s = { value = 120.0, unit = "s", assumption = true }
pc_fault_rate_per_h = { value = 0.01, unit = "1/h", assumption = true }
pc_fault_duration_s = { value = 600.0, unit = "s", assumption = true }

[handshake]
local_latency_s = { value = 0.05, unit = "s", assumption = true }
fm_latency_s = { value = 0.2, unit = "s", assumption = true }
p_msg_loss = { value = 0.0, unit = "1", assumption = true }
response_timeout_s = { value = 2.0, unit = "s", assumption = true }
max_retries = { value = 1, unit = "count", assumption = true }
hold_retry_s = { value = 15.0, unit = "s", assumption = true }
pc_silence_alert_s = { value = 30.0, unit = "s", assumption = true }

[policy]
assignment = "MIN_ETA"
dispatch = "IMMEDIATE"
holding = "BOUNDED_HOLD"
drone_rebalancing = "NEAREST_UNCLAIMED"
pod_rebalancing = "MIN_THRESHOLD"
diversion = "NEAREST_FEASIBLE"
in_occupied_action = "HOLD"
max_hold_s = { value = 180.0, unit = "s", assumption = true }
marker_hold_s = { value = 60.0, unit = "s", assumption = true }
marker_max_hold_cycles = { value = 1, unit = "count", assumption = true }
# 0 turns threshold rebalancing off: pods go home by RETURN_HOME (derived/pads.toml).
pod_min_per_pad = { value = 0, unit = "count", assumption = true }

[truck]
matrix_source = "FILE"
dispatch_delay_s = { value = 900.0, unit = "s", assumption = true }
load_s = { value = 300.0, unit = "s", assumption = true }
unload_s = { value = 300.0, unit = "s", assumption = true }
# Index i applies to departures in local hour [i, i+1). Placeholder shape: slower at 07-09 and 16-18.
tod_speed_factors = [
  { value = 1.0, unit = "1", assumption = true },
  { value = 1.0, unit = "1", assumption = true },
  { value = 1.0, unit = "1", assumption = true },
  { value = 1.0, unit = "1", assumption = true },
  { value = 1.0, unit = "1", assumption = true },
  { value = 0.95, unit = "1", assumption = true },
  { value = 0.85, unit = "1", assumption = true },
  { value = 0.6, unit = "1", assumption = true },
  { value = 0.65, unit = "1", assumption = true },
  { value = 0.8, unit = "1", assumption = true },
  { value = 0.85, unit = "1", assumption = true },
  { value = 0.85, unit = "1", assumption = true },
  { value = 0.8, unit = "1", assumption = true },
  { value = 0.85, unit = "1", assumption = true },
  { value = 0.85, unit = "1", assumption = true },
  { value = 0.75, unit = "1", assumption = true },
  { value = 0.6, unit = "1", assumption = true },
  { value = 0.6, unit = "1", assumption = true },
  { value = 0.75, unit = "1", assumption = true },
  { value = 0.9, unit = "1", assumption = true },
  { value = 0.95, unit = "1", assumption = true },
  { value = 1.0, unit = "1", assumption = true },
  { value = 1.0, unit = "1", assumption = true },
  { value = 1.0, unit = "1", assumption = true },
]

[metrics]
hist_bin_s = { value = 10.0, unit = "s", assumption = true }
hist_max_s = { value = 14400.0, unit = "s", assumption = true }

[costs]
truck_per_m = { value = 0.0008, unit = "cu/m", assumption = true }
truck_per_s = { value = 0.012, unit = "cu/s", assumption = true }
drone_per_s = { value = 0.002, unit = "cu/s", assumption = true }
energy_per_j = { value = 4.0e-8, unit = "cu/J", assumption = true }

[demand]
deadline_offset_s = { value = 3600.0, unit = "s", assumption = true }
# About five hours of one warehouse's requests; beyond that a shipper books another carrier.
max_backlog_per_pad = { value = 20, unit = "count", assumption = true }
# @flows: written by the pipeline (scenario.py), warehouse pads to every other pad.
